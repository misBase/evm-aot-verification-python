session EVM_AOT in "theory" = HOL +
  options [timeout = 600, document = pdf, document_output = "output"]
  sessions
    "HOL-Library"
    "HOL-Data_Structures"
  theories
    EVM_state
    EVM_syntax
    EVM_semantics
    EVMCommType
    Keccak
    WordOld
    uint256
    Exp

(* Regression lemmas, checked by evaluation, for the semantic errors that the GeneralStateTests
   comparison found (state-tests/FIXES.md). *)
session EVM_AOT_Fixes in "fixes" = EVM_AOT +
  options [timeout = 600, document = false]
  theories
    EVM_semantics_fixes
