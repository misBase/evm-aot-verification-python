(set-logic QF_BV)
(declare-fun a () (_ BitVec 256))
(declare-fun b () (_ BitVec 256))
(declare-fun result () (_ BitVec 256))
(assert (= result (let ((a!1 (concat (concat (bvor ((_ extract 255 192) a)
                                 ((_ extract 255 192) b))
                           (bvor ((_ extract 191 128) a)
                                 ((_ extract 191 128) b)))
                   (bvor ((_ extract 127 64) a) ((_ extract 127 64) b)))))
  (concat a!1 (bvor ((_ extract 63 0) a) ((_ extract 63 0) b))))))
(check-sat)
