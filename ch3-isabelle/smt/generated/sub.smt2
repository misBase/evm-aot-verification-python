(set-logic QF_BV)
(declare-fun a () (_ BitVec 256))
(declare-fun b () (_ BitVec 256))
(declare-fun result () (_ BitVec 256))
(assert (= result (let ((a!1 ((_ extract 64 64)
             (bvsub (concat #b0 ((_ extract 63 0) a))
                    (concat #b0 ((_ extract 63 0) b)))))
      (a!5 ((_ extract 63 0)
             (bvsub (concat #b0 ((_ extract 63 0) a))
                    (concat #b0 ((_ extract 63 0) b))))))
(let ((a!2 (bvsub (bvsub (concat #b0 ((_ extract 127 64) a))
                         (concat #b0 ((_ extract 127 64) b)))
                  (concat #b0 ((_ zero_extend 63) a!1)))))
(let ((a!3 (bvsub (bvsub (concat #b0 ((_ extract 191 128) a))
                         (concat #b0 ((_ extract 191 128) b)))
                  (concat #b0 ((_ zero_extend 63) ((_ extract 64 64) a!2))))))
(let ((a!4 (bvsub (bvsub (concat #b0 ((_ extract 255 192) a))
                         (concat #b0 ((_ extract 255 192) b)))
                  (concat #b0 ((_ zero_extend 63) ((_ extract 64 64) a!3))))))
  (concat (concat (concat ((_ extract 63 0) a!4) ((_ extract 63 0) a!3))
                  ((_ extract 63 0) a!2))
          a!5)))))))
(check-sat)
